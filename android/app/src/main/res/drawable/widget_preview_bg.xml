<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft shadow -->
    <item android:left="1dp" android:top="3dp" android:right="-1dp" android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- paper -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFF9D6" android:endColor="#FFFFF1B8" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</layer-list>
